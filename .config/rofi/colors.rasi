* {
    background: rgba(26, 13, 16, 0.92);
    foreground: #f2d7db;
    primary: #ff4d5a;
    primary-fixed: #ffdadb;
    primary-fixed-dim: #ffb3b8;
    on-primary: #ffffff;
    on-primary-fixed: #2a0a10;
    on-primary-fixed-variant: #8b0f1f;
    primary-container: #8b0f1f;
    on-primary-container: #ffdadb;
    secondary: #e0a0b0;
    secondary-fixed: #ffd9e0;
    secondary-fixed-dim: #e0a0b0;
    on-secondary: #2a0a10;
    on-secondary-fixed: #2a0a10;
    on-secondary-fixed-variant: #5c2a33;
    secondary-container: #5c2a33;
    on-secondary-container: #ffd9e0;
    tertiary: #d96b7a;
    tertiary-fixed: #ffd9e0;
    tertiary-fixed-dim: #d96b7a;
    on-tertiary: #2a0a10;
    on-tertiary-fixed: #2a0a10;
    on-tertiary-fixed-variant: #7a1f2b;
    tertiary-container: #7a1f2b;
    on-tertiary-container: #ffd9e0;
    error: #ff2e3f;
    on-error: #ffffff;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #2a1116;
    on-surface: #f2d7db;
    on-surface-variant: #d8b4ba;
    outline: #a0525e;
    outline-variant: #5c2a33;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f2d7db;
    inverse-on-surface: #2a1116;
    inverse-primary: #ffb3b8;
    surface-dim: #1a0d10;
    surface-bright: #3a1c22;
    surface-container-lowest: #140a0d;
    surface-container-low: #241015;
    surface-container: #2a1116;
    surface-container-high: #34161c;
    surface-container-highest: #3f1b22;
}
